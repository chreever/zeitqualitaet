<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Zeitqualität</title>
  
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  
  {# Dynamisches Vorschaubild für Social Media #}
  {% set ogImage = post_image | default(image) %}
  {% if ogImage %}
    <meta property="og:image" content="https://zeitqualitaet.at{{ ogImage | url }}">
  {% else %}
    <meta property="og:image" content="https://zeitqualitaet.at/img/christian-portraet.jpg">
  {% endif %}

  {# Video-Daten für Facebook und Messenger #}
  {% set ogVideo = featured_video | default(video) %}
  {% if ogVideo %}
    <meta property="og:video" content="https://zeitqualitaet.at{{ ogVideo | url }}">
    <meta property="og:video:secure_url" content="https://zeitqualitaet.at{{ ogVideo | url }}">
    <meta property="og:video:type" content="video/mp4">
  {% endif %}

  <link rel="icon" type="image/svg+xml" href="/img/zq-favicon.svg?v=2">
  <link rel="alternate icon" href="/img/zq-favicon.png?v=2">
  <link rel="apple-touch-icon" href="/img/zq-favicon.png?v=2">

  <link rel="stylesheet" href="/css/style.css">

</head>
<body>

<nav>
  <div class="nav-inner">
    <a href="/" class="logo-container" aria-label="Zur Startseite">
      <svg viewBox="0 0 120 120" style="height: 40px; width: 40px;">
        <defs>
            <linearGradient id="gold-logo" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#f3e5ab"/><stop offset="50%" stop-color="#d4af37"/><stop offset="100%" stop-color="#997a26"/>
            </linearGradient>
        </defs>
        <circle cx="60" cy="60" r="54" fill="none" stroke="url(#gold-logo)" stroke-width="1.5" opacity="0.4"/>
        <path d="M60 22 Q60 60 22 60 Q60 60 60 98 Q60 60 98 60 Q60 60 60 22 Z" fill="url(#gold-logo)"/>
      </svg>
      <span style="font-family: var(--font-display); font-size: 1.6rem; color: var(--text); letter-spacing: 0.05em;">Zeitqualität</span>
    </a>
    <div class="nav-links">
        <a href="/">← Zurück zur Übersicht</a>
    </div>
  </div>
</nav>

<div class="article-container">
  <a href="javascript:history.back()" class="back-btn">← Zurück</a>
  
  <div id="media-container">
    {% set finalImage = post_image or image %}
    {% set finalVideo = featured_video or video %}

    {% if finalImage %}
      <img class="article-image" src="{{ finalImage | url }}" alt="{{ title }}">
    {% elif finalVideo %}
      <video class="article-image" autoplay muted loop playsinline>
        <source src="{{ finalVideo | url }}#t=0.1" type="video/mp4">
      </video>
    {% endif %}
  </div>
  
  <article id="post-content" class="post-content">
    <h1>{{ title }}</h1>
    
    {# HIER IST DER WICHTIGSTE PLATZHALTER #}
    {{ content | safe }}

   
  </article>
  
  <div style="text-align: center;">
    <button id="share-btn" class="share-btn">↗ Beitrag teilen</button>
  </div>
</div>

<footer>
  <p>© 2026 Zeitqualität · Christian Balas</p>
</footer>

<div id="image-modal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(7,8,11,0.95); backdrop-filter:blur(10px); cursor:zoom-out; align-items:center; justify-content:center; padding:2rem; flex-direction:column;">
  <img id="modal-img" src="" style="max-width:95%; max-height:85vh; border-radius:var(--radius); box-shadow:0 10px 40px rgba(0,0,0,0.5); border:1px solid var(--border);">
  <div id="modal-caption" style="color:var(--accent); font-family:var(--font-body); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-top:1.5rem; font-size:0.85rem; text-align:center; max-width:800px;"></div>
  <div style="position:absolute; top:2rem; right:2rem; color:var(--text-muted); font-family:var(--font-body); font-weight: 600; letter-spacing: 0.1em; font-size:0.75rem;">ESC ZUM SCHLIESSEN</div>
</div>

<script>
  // Share Button Logik
  const sb = document.getElementById('share-btn');
  if(sb) sb.addEventListener('click', async () => {
    if(navigator.share) { try { await navigator.share({title:document.title, url:window.location.href}); } catch(e){} }
    else { 
      navigator.clipboard.writeText(window.location.href); 
      sb.innerHTML = 'Link kopiert'; 
      setTimeout(()=>sb.innerHTML='↗ Beitrag teilen',2000); 
    }
  });

  // Lightbox Logik
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('image-modal');
    const modalImg = document.getElementById('modal-img');
    const modalCaption = document.getElementById('modal-caption');
    const content = document.getElementById('post-content');
    if(content) {
      content.querySelectorAll('img').forEach(img => {
        img.onclick = () => {
          modal.style.display = 'flex';
          modalImg.src = img.src;
          const parent = img.closest('figure');
          const caption = parent ? parent.querySelector('figcaption') : img.nextElementSibling;
          modalCaption.innerText = (caption && (caption.tagName === 'FIGCAPTION' || caption.tagName === 'EM')) ? caption.innerText : "";
        };
      });
    }
    modal.onclick = () => { modal.style.display = 'none'; };
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') modal.style.display = 'none'; });
  });
</script>
</body>
</html>
